{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet-window",
  "description": "The local pet renderer may drag only its own transparent window. The remote Dashboard receives no Tauri capability.",
  "local": true,
  "windows": ["pet"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "allow-ack-pet-interaction",
    "allow-confirm-pet-action",
    "allow-cancel-pet-action"
  ]
}
