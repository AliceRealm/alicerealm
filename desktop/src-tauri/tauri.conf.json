{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AliceRealm",
  "version": "0.2.0",
  "identifier": "com.alicerealm.desktop",
  "build": {
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AliceRealm",
        "url": "https://app.alicerealm.com/dashboard/today",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      },
      {
        "label": "pet",
        "title": "AliceRealm Pet",
        "url": "pet.html",
        "width": 260,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "SocialNetworking",
    "shortDescription": "AliceRealm dashboard and desktop pet",
    "longDescription": "AliceRealm desktop hosts the owner dashboard, local Agent approvals, and the AliceRealm pet experience.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["alicerealm"]
      }
    }
  }
}
